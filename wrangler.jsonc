{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "quicklink-download",
  "compatibility_date": "2026-11-17",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./website",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "routes": [
    {
      "pattern": "quicklink.hnode.me",
      "custom_domain": true,
      "zone_name": "hnode.me"
    }
  ]
}
